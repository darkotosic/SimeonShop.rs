APP_ENV=development
APP_NAME=SimeonShop API
PROJECT_VERSION=0.3.0
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://simeonshop:simeonshop@localhost:5432/simeonshop
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@simeonshop.rs
ALLOW_PUBLIC_REGISTRATION=false
BOOTSTRAP_ADMIN_TOKEN=change-me
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHECKOUT=5/minute
LOG_LEVEL=INFO
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Simeon Shop
